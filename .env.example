# Copy this file to .env (and never commit the real .env) or paste these
# into your deployment platform's "Secrets" panel.

# --- Required ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyDitwguOelyY9Eyh1p4PeKCFE4odfr9MaY

# --- Razorpay Test Mode (recommended — the app works without it, in a
# clearly-labeled simulated payment mode, but the hackathon is literally
# themed on agents that complete real payment flows) ---
# Free signup, no KYC needed for Test Mode: https://dashboard.razorpay.com/signup
# Dashboard -> Settings -> API Keys -> Generate Test Key
# Test keys start with rzp_test_ — double check you did NOT copy Live keys.
RAZORPAY_KEY_ID= 
RAZORPAY_KEY_SECRET=

# --- Optional ---

# Public URL this app is reachable at, used to build the Razorpay Checkout
# success-redirect. For local dev the default (localhost:8501) is fine.
# For a deployed app, set this to your real URL, e.g.
# https://demand2deal.streamlit.app
APP_PUBLIC_URL=http://localhost:8501

# Seconds to wait for any single webcmd command before giving up.
WEBCMD_TIMEOUT_SECONDS=45

# Safety switch (Section 5 / hard rule #2): with this unset or "false",
# the supplier-side purchase is prepared (COD, no stored payment method)
# but never finalized -- amazon-in checkout stops one click short of
# --place-order. Only set to "true" once you've deliberately decided to
# let the agent place a real order with real money.
LIVE_PURCHASE_ENABLED=false

# --workspace value for webcmd Cloud (hosted) mode, if you're using it.
# Irrelevant in local mode.
WEBCMD_WORKSPACE=

# Maximum order spend ceiling (in INR). Defaults to 50,000 per proposal.
# Set higher if your demo scenario requires larger orders.
# MAX_ORDER_SPEND=50000

# Path to the audit log file (JSON). Defaults to audit_log.json in the project root.
# AUDIT_LOG_PATH=audit_log.json